[18.023, "o", "Usage: texas-scrape property search [OPTIONS]\r\n\r\n  Search for property records.\r\n\r\nOptions:\r\n  -c, --county [harris|travis]  County to search  [required]\r\n  -o, --owner TEXT              Owner name to search\r\n  -a, --address TEXT            Address to search\r\n  -n, --account TEXT            Account number\r\n  -f, --output PATH             Output file (JSON)\r\n  -l, --limit INTEGER           Maximum results to return\r\n  --help                        Show this message and exit.\r\n"]
